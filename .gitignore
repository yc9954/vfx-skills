# Publish a small, explicit source surface. Production data never enters Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/pyproject.toml
!/NOTICE.md
!/vfx.py
!/src/
!/src/**
!/skills/
!/skills/**
!/config/
!/config/**
!/examples/
!/examples/**
!/docs/
!/docs/**
!/tests/
!/tests/**
!/tools/
!/tools/**
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
*.pem
*.key
*.log
*.mp4
*.mov
*.blend*
*.fbx
*.glb
*.npz
*.safetensors
node_modules/
.venv/
*.egg-info/
build/
dist/
.local/
.secrets/
*.local.json
